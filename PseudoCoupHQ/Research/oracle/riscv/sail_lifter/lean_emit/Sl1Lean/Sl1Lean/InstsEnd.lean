def execute_ZICOND_RTYPE (rs2 : regidx) (rs1 : regidx) (rd : regidx) (op : zicondop) : SailM ExecutionResult := do
  let condition ← (( do
    match op with
    | .CZERO_EQZ => (pure ((← (rX_bits rs2)) == (zeros (n := 64))))
    | .CZERO_NEZ => (pure ((← (rX_bits rs2)) != (zeros (n := 64)))) ) : SailM Bool )
  (wX_bits rd
    (← do
      if (condition : Bool)
      then (pure (zeros (n := 64)))
      else (rX_bits rs1)))
  (pure RETIRE_SUCCESS)

def execute_ZBS_RTYPE (rs2 : regidx) (rs1 : regidx) (rd : regidx) (op : brop_zbs) : SailM ExecutionResult := do
  let rs1_val ← do (rX_bits rs1)
  let rs2_val ← do (rX_bits rs2)
  let mask : xlenbits :=
    (shift_bits_left (zero_extend (m := 64) 1#1) (Sail.BitVec.extractLsb rs2_val 5 0))
  let result : xlenbits :=
    match op with
    | .BCLR => (rs1_val &&& (Complement.complement mask))
    | .BEXT => (zero_extend (m := 64) (bool_to_bit ((rs1_val &&& mask) != (zeros (n := 64)))))
    | .BINV => (rs1_val ^^^ mask)
    | .BSET => (rs1_val ||| mask)
  (wX_bits rd result)
  (pure RETIRE_SUCCESS)

