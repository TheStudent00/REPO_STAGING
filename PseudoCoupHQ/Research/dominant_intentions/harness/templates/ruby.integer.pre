# integer probe bodies - ruby (unbounded camp, flooring division).
def op(x) = x
def f_intU1_a() = fmts(123456 + 654321)
def f_intU1_b() = fmts(1000 * 1000)
def f_intU1_c() = fmts(5 - 9)
def f_intU2_a() = fmtb(op(3) < op(5))
def f_intU2_b() = fmtb(op(-7) <= op(-7))
def f_intU2_c() = fmtb(op(10) == op(10))
def f_intU2_d() = fmtb(op(2) > op(100))
def f_intU3_a() = fmts(op(42))
def f_intU3_b() = fmts(op(-12345))
def f_Fi1_a() = fmts(9007199254740993)
def f_Fi1_b() = fmts(9223372036854775807)
def f_Fi1_c() = fmts(2 ** 70)
def f_Fi2_a() = fmts(op(9223372036854775807) + 1)
def f_Fi3_a() = fmts(op(7) / op(2))
def f_Fi3_b() = fmts(op(-7) / op(2))
def f_Fi3_c() = fmts(op(-7).div(op(2)))
def f_Fi4_a() = fmts(op(-7) % op(2))
def f_Fi4_b() = fmts(op(7) % op(-2))
def f_Fi4_c() = fmts(op(7) % op(2))
def f_Fi5_a() = fmts(op(7) / op(0))
def f_Fi5_b() = fmts(op(7) % op(0))
def f_Fi6_a() = fmts(op(1) << 31)
def f_Fi6_b() = fmts(op(1) << 32)
