--- the probe source ---
public class Probe {
    static int af(int a, int b) {
        return a + b;
    }
    static int af2(int a, int b) {
        return a / b;
    }
    public static void main(String[] args) {
        int n = 200000;
        int acc = 0;
        int i = 0;
        while (i < n) {
            acc = af(acc, 1);
            i = i + 1;
        }
        int acc2 = 0;
        int j = 1;
        while (j < n) {
            acc2 = af2(j, 3);
            j = j + 1;
        }
        System.out.println("acc=" + acc + " acc2=" + acc2);
    }
}
