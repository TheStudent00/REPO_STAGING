# Python build litter. These churn on every test run and carry no information;
# 36 .pyc files had been tracked before this file existed (untracked
# 2026-07-30 with `git rm -r --cached`).
__pycache__/
*.py[cod]
.pytest_cache/

# Scratch a run leaves behind. Regenerated artifacts that MATTER are committed
# deliberately (Tools/slicer/extracted/ is committed on purpose — the tests
# compare the committed copy against a fresh run).
*.egg-info/
.venv/
