# The hot-folder daemon. On the internal network only — its sole reachable
# peer is sandbox-proxy:3128.
[Unit]
Description=Sandbox script runner (hot-folder daemon)
Requires=sandbox-proxy.service
After=sandbox-proxy.service

[Container]
ContainerName=sandbox-runner
Image=localhost/sandbox-runner:latest
Network=sandbox-internal.network

# Quadlet generates `podman run --rm`, so the container is DESTROYED on
# every stop and restart. Everything that must outlive a restart is either a
# host bind or a named volume below.
#
# AGENT LANE (host binds, added 2026-07-30). A Cowork/Claude session can write
# files under <WORKSPACE_DIR> but cannot run podman. Binding these four makes the
# hot folder reachable by a plain file write: the session writes
# agent/drop/x.sh, close_write fires, and it reads agent/status/x.sh.status and
# agent/out/ back — no shell needed on the session's side. These replace the
# sandbox-logs/sandbox-out named volumes, which were unreadable from a session
# because podman's volume storage sits outside the connected folders.
Volume=%h/Programming/SandboxDesign/agent/drop:/drop
Volume=%h/Programming/SandboxDesign/agent/out:/out
Volume=%h/Programming/SandboxDesign/agent/logs:/logs
Volume=%h/Programming/SandboxDesign/agent/status:/status

# CONFIGURED MOUNTS — generated, do not hand-edit.
#
# Everything between the two markers below is written by
# ./install_quadlet.sh from ./mounts.conf when it installs this unit into
# ~/.config/containers/systemd/. The copy in the repo keeps the markers
# empty, because this repo is a project-agnostic TEMPLATE: which
# directories a machine exposes is that machine's configuration, not the
# tool's. See mounts.conf.example.
#
# Default is read-only. Products go to /out, and the caller places them —
# that is what makes "a run cannot damage the original" true rather than
# hoped.
# >>> MOUNTS
# <<< MOUNTS

# The one place state is MEANT to survive between runs (opt-in; see README).
Volume=sandbox-persist:/persist

# /work is a size-capped tmpfs. A run that exceeds the cap fails loudly with
# ENOSPC inside the container instead of filling the host disk — which is how a
# generated-file extraction wedged a session on 2026-07-30. Raising it is a
# deliberate act, not a default. Memory covers the tmpfs plus process headroom.
Memory=12g
PidsLimit=2048
DropCapability=ALL
NoNewPrivileges=true
Tmpfs=/tmp:rw,nosuid,nodev,size=2g
Tmpfs=/work:rw,nosuid,nodev,size=4g
PodmanArgs=--cpus=6

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
