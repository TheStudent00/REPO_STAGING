# integer probe bodies - python (unbounded camp).
def op(x): return x
def f_intU1_a(): return fmts(123456 + 654321)
def f_intU1_b(): return fmts(1000 * 1000)
def f_intU1_c(): return fmts(5 - 9)
def f_intU2_a(): return fmtb(op(3) < op(5))
def f_intU2_b(): return fmtb(op(-7) <= op(-7))
def f_intU2_c(): return fmtb(op(10) == op(10))
def f_intU2_d(): return fmtb(op(2) > op(100))
def f_intU3_a(): return fmts(op(42))
def f_intU3_b(): return fmts(op(-12345))
def f_Fi1_a(): return fmts(9007199254740993)
def f_Fi1_b(): return fmts(9223372036854775807)
def f_Fi1_c(): return fmts(2 ** 70)
def f_Fi2_a(): return fmts(op(9223372036854775807) + 1)
def f_Fi3_a(): return fmts(op(7) / op(2))
def f_Fi3_b(): return fmts(op(-7) / op(2))
def f_Fi3_c(): return fmts(op(-7) // op(2))
def f_Fi4_a(): return fmts(op(-7) % op(2))
def f_Fi4_b(): return fmts(op(7) % op(-2))
def f_Fi4_c(): return fmts(op(7) % op(2))
def f_Fi5_a(): return fmts(op(7) // op(0))
def f_Fi5_b(): return fmts(op(7) % op(0))
def f_Fi6_a(): return fmts(op(1) << 31)
def f_Fi6_b(): return fmts(op(1) << 32)
