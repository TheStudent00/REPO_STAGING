    "read": "v.inspect"
   },
   {
    "rep": "Rational",
    "spelling": "Rational(1.5)",
    "kind": "constructor",
    "note": "exact ratio holder; converts a finite float exactly but has no room for the non-finite values.",
    "decl": "v = Rational({V})",
    "read": "v.to_s"
   },
   {
    "rep": "BigDecimal",
    "spelling": "BigDecimal(\"1.5\")",
    "kind": "constructor",
    "pre": "require 'bigdecimal'",
    "note": "decimal holder built from the float's digit string; the non-finite specials are not decimal digits at all.",
    "decl": "v = BigDecimal(({V}).to_s)",
    "read": "v.to_s('F')"
   }
  ],
  "text": [
   {
    "rep": "String",
    "spelling": "\"hello\"",
    "kind": "literal",
