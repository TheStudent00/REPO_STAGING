-- the tactics that show the goal (LITERAL) and the stage that closed it
open Lean Elab Tactic in
elab "leanpath_show_lhs" : tactic => do
  let g ← getMainTarget
  let g ← instantiateMVars g
  match g.eq? with
  | some (_, lhs, _) => logInfo m!"LEANPATH_LHS_BEGIN\n{lhs}\nLEANPATH_LHS_END"
  | none => logInfo m!"LEANPATH_GOAL_BEGIN\n{g}\nLEANPATH_GOAL_END"

open Lean Elab Tactic in
elab "leanpath_show_goal" : tactic => do
  let g ← getMainTarget
  let g ← instantiateMVars g
  logInfo m!"LEANPATH_GOAL_BEGIN\n{g}\nLEANPATH_GOAL_END"

open Lean Elab Tactic in
elab "leanpath_stage " s:str : tactic => do
  logInfo m!"LEANPATH_STAGE {s.getString}"
