     "emptykey": "v = {\"\" => \"empty-string key\"}",
     "nested": "v = {\"outer\" => {\"inner\" => [1, 2]}}"
    }
   },
   {
    "rep": "Struct",
    "spelling": "Struct.new(:a).new(1)",
    "kind": "constructor",
    "note": "fixed set of names decided when the shape is made, not when the data arrives; the empty-string key is not a legal member name.",
    "read": "v.to_h.inspect",
    "probes": {
     "empty": "shape_r0 = Struct.new\nv = shape_r0.new",
     "flat": "shape_r3 = Struct.new(:a, :b, :c)\nv = shape_r3.new(1, 2, 3)",
     "intlike": "shape_ri = Struct.new(:\"1\", :b)\nv = shape_ri.new(\"string-one-key\", 2)",
     "emptykey": "shape_re = Struct.new(:\"\")\nv = shape_re.new(\"empty-string key\")",
     "nested": "shape_rn = Struct.new(:outer)\nv = shape_rn.new({\"inner\" => [1, 2]})"
    }
   },
   {
