    "read": "v.to_h.inspect",
    "probes": {
     "empty": "shape_r0 = Data.define\nv = shape_r0.new",
     "flat": "shape_r3 = Data.define(:a, :b, :c)\nv = shape_r3.new(a: 1, b: 2, c: 3)",
     "intlike": "shape_ri = Data.define(:\"1\", :b)\nv = shape_ri.new(:\"1\" => \"string-one-key\", :b => 2)",
     "emptykey": "shape_re = Data.define(:\"\")\nv = shape_re.new(:\"\" => \"empty-string key\")",
     "nested": "shape_rn = Data.define(:outer)\nv = shape_rn.new(outer: {\"inner\" => [1, 2]})"
    }
