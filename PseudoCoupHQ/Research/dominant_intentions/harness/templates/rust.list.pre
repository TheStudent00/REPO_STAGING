// list probe bodies - rust (Vec; slices are BORROWS; assignment MOVES).
fn mkl() -> Vec<i32> { vec![1, 2, 3] }
fn joinInts(v: &Vec<i32>) -> String {
    v.iter().map(|x| x.to_string()).collect::<Vec<String>>().join(",")
}
fn f_listU1_a() -> String { let mut a = vec![1, 2]; a.push(3); joinInts(&a) }
fn f_listU2_a() -> String { format!("{}", mkl()[1]) }
fn f_listU3_a() -> String { let mut o: Vec<i32> = Vec::new(); for x in mkl() { o.push(x); } joinInts(&o) }
fn f_listU4_a() -> String { format!("{}", mkl().len()) }
fn f_Fl3_a() -> String { let mut a = vec![1, 2]; a.push(3); a.push(4); format!("{}", a.len()) }
fn f_Fl4_a() -> String { let a = mkl(); format!("{}", a[10]) }
fn f_Fl4_c() -> String { let a = mkl(); format!("{:?}", a.get(10)) }
fn f_Fl6_a() -> String {
    let mut a = mkl();
    { let s = &mut a[0..2]; s[0] = 99; }
    format!("{}", a[0])
}
fn f_Fl7_a() -> String { fmtb(mkl() == mkl()) }
fn f_Fl8_a() -> String { let mut a = vec![10, 9, 1]; a.sort(); joinInts(&a) }
