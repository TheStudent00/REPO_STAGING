     "diamond": "t = {\"payload\" => 7}\nv = {\"via_a\" => t, \"via_b\" => t}\nr = v[\"via_a\"].equal?(v[\"via_b\"]) ? \"same\" : \"distinct\"",
     "cycle": "v = {\"name\" => \"loop\"}\nv[\"self\"] = v\nr = v[\"self\"].equal?(v) ? \"cycle\" : \"no-cycle\""
