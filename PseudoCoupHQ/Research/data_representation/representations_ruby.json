    "read": "v.to_s"
   },
   {
    "rep": "BigDecimal",
    "spelling": "BigDecimal(\"42\")",
    "kind": "constructor",
    "pre": "require 'bigdecimal'",
    "note": "exact decimal holder, built from the literal's digit string.",
    "decl": "v = BigDecimal(({V}).to_s)",
    "read": "v.to_s('F')"
   }
  ],
  "fractional": [
   {
    "rep": "Float",
    "spelling": "1.5",
