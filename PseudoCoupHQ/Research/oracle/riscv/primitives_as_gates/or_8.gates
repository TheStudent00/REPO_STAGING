# or at 8 bits: the result bits out0..out7 as a circuit over a0..a7, b0..b7
# produced by z3's bit-blast tactic; equal to the operator by z3's own construction
g1 = or(a0, b0)
g2 = =(k!120, g1)
g3 = or(a1, b1)
g4 = =(k!121, g3)
g5 = or(a2, b2)
g6 = =(k!122, g5)
g7 = or(a3, b3)
g8 = =(k!123, g7)
g9 = or(a4, b4)
g10 = =(k!124, g9)
g11 = or(a5, b5)
g12 = =(k!125, g11)
g13 = or(a6, b6)
g14 = =(k!126, g13)
g15 = or(a7, b7)
g16 = =(k!127, g15)
