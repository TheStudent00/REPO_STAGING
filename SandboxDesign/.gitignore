run_logs/

# Per-machine configuration: which host directories this install exposes.
# The repo is a project-agnostic template, so the real file stays out of it.
# mounts.conf.example is committed and is the documentation.
mounts.conf

# Per-machine egress policy: which hosts THIS install may reach.
# Same pattern as mounts.conf — the repo is project-agnostic, so the
# live allowlist stays out of it; allowlist.txt.example is the
# committed baseline a new install copies from.
proxy/allowlist.txt
