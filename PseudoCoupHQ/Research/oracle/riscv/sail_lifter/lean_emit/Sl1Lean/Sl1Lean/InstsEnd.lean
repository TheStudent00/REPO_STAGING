  | .C_LUI (imm, rd) => (pure (execute_C_LUI imm rd))
  | .C_SRLI (shamt, rsd) => (pure (execute_C_SRLI shamt rsd))
  | .C_SRAI (shamt, rsd) => (pure (execute_C_SRAI shamt rsd))
