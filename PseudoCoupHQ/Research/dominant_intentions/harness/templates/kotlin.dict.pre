// dict probe bodies - kotlin (LinkedHashMap by default: insertion-ordered).
fun mkd(): MutableMap<String, String> = mutableMapOf("k" to "v1")
fun f_dictU1_a(): String = mkd()["k"].toString()
fun f_dictU2_a(): String { val d = mutableMapOf("k" to "v1"); d["k"] = "v2"; return d["k"].toString() }
fun f_dictU3_a(): String { val d = mkd(); d.remove("k"); return fmtb(d.containsKey("k")) }
fun f_dictU4_a(): String { val d = mutableMapOf<String, Int>(); d["a"] = 1; d["b"] = 2; d["c"] = 3; return d.size.toString() }
fun f_Fd1_b(): String { val d = mutableMapOf<Int, String>(); d[1] = "v"; return d[1].toString() }
fun f_Fd2_a(): String { val d = mutableMapOf<String, Int>(); d["z"] = 1; d["a"] = 1; d["m"] = 1; return d.keys.joinToString(",") }
fun f_Fd3_a(): String = mkd()["nope"].toString()
fun f_Fd4_a(): String {
    val d = mutableMapOf("a" to 1, "b" to 2, "c" to 3, "d" to 4, "e" to 5)
    for (k in d.keys) { if (k == "c") { d.remove(k) } }
    return "ok"
}
fun f_Fl9d_a(): String { val a = mkd(); val b = a; b["k"] = "99"; return a["k"].toString() }
