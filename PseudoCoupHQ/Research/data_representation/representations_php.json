{
  "language": "php",
  "layer": 2,
  "purpose": "The ways a running php program can HOLD layer-1 content. Not layer 1 (the data is fixed), not layer 3 (no operations beyond load-and-read-back), not the type system.",
  "reference": "language knowledge, checked against ../type_vocabulary/raw/php.types.json as a candidate checklist only (superseded node; not a decision instrument).",
  "probe_style": "cell",
  "spell": {
