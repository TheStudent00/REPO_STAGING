// integer probe bodies - typescript. The census claims typescript has NO
// integer: `number` is the 64-bit float, so these run as the float-only camp.
function op(x: number): number { return x; }
function f_intU1_a(): string { return fmts(123456 + 654321); }
function f_intU1_b(): string { return fmts(1000 * 1000); }
function f_intU1_c(): string { return fmts(5 - 9); }
function f_intU2_a(): string { return fmtb(op(3) < op(5)); }
function f_intU2_b(): string { return fmtb(op(-7) <= op(-7)); }
function f_intU2_c(): string { return fmtb(op(10) === op(10)); }
function f_intU2_d(): string { return fmtb(op(2) > op(100)); }
function f_intU3_a(): string { return fmts(op(42)); }
function f_intU3_b(): string { return fmts(op(-12345)); }
function f_Fi1_a(): string { return fmts(9007199254740993); }
function f_Fi1_b(): string { return fmts(9223372036854775807); }
function f_Fi2_a(): string { return fmts(op(9223372036854775807) + 1); }
function f_Fi3_a(): string { return fmts(op(7) / op(2)); }
function f_Fi3_b(): string { return fmts(op(-7) / op(2)); }
function f_Fi4_a(): string { return fmts(op(-7) % op(2)); }
function f_Fi4_b(): string { return fmts(op(7) % op(-2)); }
function f_Fi4_c(): string { return fmts(op(7) % op(2)); }
function f_Fi5_a(): string { return fmts(op(7) / op(0)); }
function f_Fi5_b(): string { return fmts(op(7) % op(0)); }
function f_Fi6_a(): string { return fmts(op(1) << 31); }
function f_Fi6_b(): string { return fmts(op(1) << 32); }
