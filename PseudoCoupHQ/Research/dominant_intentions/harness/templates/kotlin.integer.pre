// integer probe bodies - kotlin (fixed width, silent wrap, truncating /).
fun op64(x: Long): Long = x
fun op32(x: Int): Int = x
fun f_intU1_a(): String = (123456 + 654321).toString()
fun f_intU1_b(): String = (1000 * 1000).toString()
fun f_intU1_c(): String = (5 - 9).toString()
fun f_intU2_a(): String = fmtb(op64(3) < op64(5))
fun f_intU2_b(): String = fmtb(op64(-7) <= op64(-7))
fun f_intU2_c(): String = fmtb(op64(10) == op64(10))
fun f_intU2_d(): String = fmtb(op64(2) > op64(100))
fun f_intU3_a(): String = op64(42).toString()
fun f_intU3_b(): String = op64(-12345).toString()
fun f_Fi1_a(): String = 9007199254740993L.toString()
fun f_Fi1_b(): String = 9223372036854775807L.toString()
fun f_Fi1_d(): String = Byte.MAX_VALUE.toString()
fun f_Fi2_a(): String = (op64(Long.MAX_VALUE) + 1).toString()
fun f_Fi3_a(): String = (op64(7) / op64(2)).toString()
fun f_Fi3_b(): String = (op64(-7) / op64(2)).toString()
fun f_Fi4_a(): String = (op64(-7) % op64(2)).toString()
fun f_Fi4_b(): String = (op64(7) % op64(-2)).toString()
fun f_Fi4_c(): String = (op64(7) % op64(2)).toString()
fun f_Fi5_a(): String = (op64(7) / op64(0)).toString()
fun f_Fi5_b(): String = (op64(7) % op64(0)).toString()
fun f_Fi6_a(): String = (op32(1) shl 31).toString()
fun f_Fi6_b(): String = (op64(1) shl 32).toString()
