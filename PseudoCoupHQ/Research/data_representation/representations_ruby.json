    "read": "r",
    "probes": {
     "shared": "s = [1, 2, 3]\ncopy = Marshal.load(Marshal.dump(s))\nv = [s, copy]\nv[0] << 99\nr = (v[1].last == 99 && v[0].equal?(v[1])) ? \"shared\" : \"copied\"",
     "diamond": "t = {\"payload\" => 7}\ncopy = Marshal.load(Marshal.dump(t))\nv = [t, copy]\nr = v[0].equal?(v[1]) ? \"same\" : \"distinct\"",
     "cycle": "v = {\"name\" => \"loop\"}\nv[\"self\"] = v\ncopy = Marshal.load(Marshal.dump(v))\nr = copy[\"self\"].equal?(copy) ? \"cycle\" : \"no-cycle\""
